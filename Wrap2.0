/*************************************************
 * MEASUREMENT EXTRACTION SCRIPT
 *
 * Supports:
 * - Brand Lift Summary
 * - Conversion Lift Summary
 * - Sales Lift Summary
 * - Visitation Lift Summary
 *
 * Run rules:
 * - Only process rows where the raw link field is populated
 * - Skip rows where Data Extraction Date already has a value
 *
 * Source support:
 * - Google Sheets
 * - CSV
 * - Google Docs
 * - Google Slides
 * - PDF (OCR via Drive API for text fallback only)
 * - File URLs / raw file IDs / folder URLs / raw folder IDs
 *
 * Notes:
 * - Excel files are not supported in this version
 * - Campaign ID is extracted as a 5- or 6-digit numeric value
 * - For Brand Lift, Campaign ID is explicit-only:
 *   Campaign ID / Campaign_ID / CampaignID
 * - Visitation ignores Visit Lift Index
 *************************************************/

/*************************************************
 * STEP 1 TOPLINE SUMMARY EXTRACT
 *
 * Raw cell display text is used for:
 * - Study ID
 * - Advertiser
 * - Campaign Name
 *
 * Hyperlink in that same cell is used to open the source file.
 *
 * Filename/cell text schema:
 * StudyID_Advertiser_Campaign Details...
 *************************************************/

const CONFIG = {
  SPREADSHEET_ID: '11By-pHGAa3_wlczUE4-1FYtN4-VERywC0Bxsh3B-lCU',
  HEADER_ROW: 1,
  DATE_HEADER: 'Data Extraction Date',
  DATE_FORMAT: 'yyyy-MM-dd',
  TIMEZONE: Session.getScriptTimeZone(),
  DEBUG: true,

  TABS: [
    { sheetName: 'Brand Lift Summary', rawHeader: 'BLS Raw Data Link', parser: 'brandLift' },
    { sheetName: 'Conversion Lift Summary', rawHeader: 'CLS Raw Data Link', parser: 'conversionLift' },
    { sheetName: 'Sales Lift Summary', rawHeader: 'Sales Lift Raw', parser: 'salesLift' },
    { sheetName: 'Visitation Lift Summary', rawHeader: 'Visitation Lift Raw', parser: 'visitationLift' }
  ]
};

/* =========================================================
 * MAIN
 * ========================================================= */

function extractAllMeasurementTabs() {
  CONFIG.TABS.forEach(function(tab) {
    processSheet_(tab, false);
  });
}

function extractActiveRowCurrentSheet() {
  var ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  var sheet = ss.getActiveSheet();
  var tab = CONFIG.TABS.find(function(t) {
    return t.sheetName === sheet.getName();
  });

  if (!tab) throw new Error('Active sheet is not a supported extraction tab.');
  processSheet_(tab, true);
}

function processSheet_(tabConfig, activeRowOnly) {
  var ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  var sheet = ss.getSheetByName(tabConfig.sheetName);
  if (!sheet) return;

  ensureHeaderExists_(sheet, CONFIG.DATE_HEADER);

  var values = sheet.getDataRange().getValues();
  if (values.length < 2) return;

  var headers = values[CONFIG.HEADER_ROW - 1];
  var headerMap = buildHeaderMap_(headers);

  var rawCol = headerMap[toKey_(tabConfig.rawHeader)];
  var dateCol = headerMap[toKey_(CONFIG.DATE_HEADER)];

  if (!rawCol) throw new Error('Missing raw link column: ' + tabConfig.rawHeader);
  if (!dateCol) throw new Error('Missing date column: ' + CONFIG.DATE_HEADER);

  var rowNums = activeRowOnly ? [sheet.getActiveRange().getRow()] : getDataRows_(sheet);

  rowNums.forEach(function(rowNum) {
    if (rowNum <= CONFIG.HEADER_ROW) return;

    var extractionDate = sheet.getRange(rowNum, dateCol).getValue();
    if (extractionDate) return;

    var rawCellName = getCellDisplayText_(sheet, rowNum, rawCol);
    var rawSourceLink = getCellLinkUrl_(sheet, rowNum, rawCol) || rawCellName;

    if (!rawCellName) return;

    try {
      if (CONFIG.DEBUG) {
        Logger.log('Processing ' + tabConfig.sheetName + ' row ' + rowNum + ': ' + rawCellName);
        Logger.log('Source link/value: ' + rawSourceLink);
      }

      var source = getSourceData_(rawSourceLink);
      var parsed = parseByType_(tabConfig.parser, source, rawCellName);

      writeParsedResultsToRow_(sheet, rowNum, headerMap, parsed);

      sheet.getRange(rowNum, dateCol).setValue(
        Utilities.formatDate(new Date(), CONFIG.TIMEZONE, CONFIG.DATE_FORMAT)
      );
    } catch (e) {
      Logger.log('Row ' + rowNum + ' failed: ' + e.message);
    }
  });
}

/* =========================================================
 * CELL LINK + DISPLAY TEXT
 * ========================================================= */

function getCellDisplayText_(sheet, rowNum, colNum) {
  return String(sheet.getRange(rowNum, colNum).getDisplayValue() || '').trim();
}

function getCellLinkUrl_(sheet, rowNum, colNum) {
  var range = sheet.getRange(rowNum, colNum);
  var richText = range.getRichTextValue();

  if (richText) {
    var wholeLink = richText.getLinkUrl();
    if (wholeLink) return wholeLink;

    var runs = richText.getRuns();
    for (var i = 0; i < runs.length; i++) {
      var url = runs[i].getLinkUrl();
      if (url) return url;
    }
  }

  var formula = range.getFormula();
  if (formula) {
    var match = formula.match(/HYPERLINK\("([^"]+)"/i);
    if (match && match[1]) return match[1];
  }

  return '';
}

/* =========================================================
 * SOURCE HANDLING
 * ========================================================= */

function getSourceData_(input) {
  var s = String(input || '').trim();

  if (/\.(csv|xlsx|xls)$/i.test(s) && s.indexOf('http') !== 0) {
    var fileByName = findDriveFileByName_(s);
    if (fileByName) return buildSourceFromFile_(fileByName);
    throw new Error('Could not find file by name: ' + s);
  }

  var id = extractDriveIdDetailed_(s);

  if (id) {
    try {
      var file = DriveApp.getFileById(id);
      return buildSourceFromFile_(file);
    } catch (fileErr) {
      if (CONFIG.DEBUG) Logger.log('Not a direct file or file access failed: ' + fileErr.message);
    }

    try {
      var folder = DriveApp.getFolderById(id);
      var bestFile = pickBestFileFromFolder_(folder);
      if (!bestFile) throw new Error('No supported file found in folder: ' + folder.getName());
      return buildSourceFromFile_(DriveApp.getFileById(bestFile.id));
    } catch (folderErr) {
      throw new Error('Could not read source: ' + folderErr.message);
    }
  }

  var fallbackFile = findDriveFileByName_(s);
  if (fallbackFile) return buildSourceFromFile_(fallbackFile);

  throw new Error('Could not parse file/folder ID or find file by name: ' + s);
}

function buildSourceFromFile_(file) {
  var fileId = file.getId();
  var fileName = file.getName();
  var mime = file.getMimeType();

  if (CONFIG.DEBUG) {
    Logger.log('Reading file: ' + fileName + ' | mime=' + mime + ' | id=' + fileId);
  }

  if (mime === MimeType.GOOGLE_SHEETS) {
    return {
      isStructured: true,
      fileType: 'google_sheet',
      fileName: fileName,
      tables: extractTablesFromGoogleSheet_(fileId)
    };
  }

  if (mime === MimeType.CSV || /\.csv$/i.test(fileName)) {
    return {
      isStructured: true,
      fileType: 'csv',
      fileName: fileName,
      tables: extractTablesFromCsv_(file)
    };
  }

  throw new Error('Unsupported file type. Use Google Sheets or CSV.');
}

function extractDriveIdDetailed_(input) {
  if (!input) return null;
  var s = String(input).trim();

  var m = s.match(/\/d\/([a-zA-Z0-9-_]+)/);
  if (m) return m[1];

  m = s.match(/\/folders\/([a-zA-Z0-9-_]+)/);
  if (m) return m[1];

  m = s.match(/[?&]id=([a-zA-Z0-9-_]+)/);
  if (m) return m[1];

  if (/^[a-zA-Z0-9-_]{25,}$/.test(s) && !/\.[a-z0-9]+$/i.test(s) && s.indexOf(' ') === -1) {
    return s;
  }

  return null;
}

function findDriveFileByName_(fileName) {
  var target = normalizeFileNameForMatch_(fileName);
  if (!target) return null;

  var files = DriveApp.searchFiles("trashed = false");
  var best = null;
  var bestScore = -1;

  while (files.hasNext()) {
    var file = files.next();
    if (!/\.csv$/i.test(file.getName()) && file.getMimeType() !== MimeType.GOOGLE_SHEETS) continue;

    var candidate = normalizeFileNameForMatch_(file.getName());
    var score = scoreFileNameMatch_(candidate, target);

    if (score > bestScore) {
      best = file;
      bestScore = score;
    }
  }

  if (CONFIG.DEBUG) {
    Logger.log('Filename search target: ' + target);
    Logger.log('Best file match: ' + (best ? best.getName() : 'NONE') + ' | score=' + bestScore);
  }

  return bestScore >= 90 ? best : null;
}

function scoreFileNameMatch_(candidate, target) {
  if (candidate === target) return 100;
  if (candidate.indexOf(target) >= 0 || target.indexOf(candidate) >= 0) return 95;

  var cParts = candidate.split('_');
  var tParts = target.split('_');
  var hits = 0;

  tParts.forEach(function(part) {
    if (part && cParts.indexOf(part) >= 0) hits++;
  });

  return Math.round((hits / Math.max(tParts.length, 1)) * 100);
}

function normalizeFileNameForMatch_(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/\.[^.]+$/, '')
    .replace(/\s*\(\d+\)\s*$/, '')
    .replace(/[’']/g, '')
    .replace(/\s+/g, '')
    .replace(/[^a-z0-9_ -]/g, '')
    .replace(/[- ]+/g, '')
    .replace(/_+/g, '_')
    .trim();
}

function pickBestFileFromFolder_(folder) {
  var files = folder.getFiles();
  var candidates = [];

  while (files.hasNext()) {
    var file = files.next();
    var mime = file.getMimeType();
    var name = file.getName().toLowerCase();

    if (mime === MimeType.GOOGLE_SHEETS || mime === MimeType.CSV || /\.csv$/i.test(name)) {
      var score = 0;
      if (name.indexOf('lift_summary') >= 0) score += 50;
      if (name.indexOf('summary') >= 0) score += 30;
      if (name.indexOf('overall') >= 0) score += 25;
      if (mime === MimeType.GOOGLE_SHEETS) score += 15;
      if (mime === MimeType.CSV) score += 10;

      candidates.push({
        id: file.getId(),
        score: score,
        updated: file.getLastUpdated()
      });
    }
  }

  if (!candidates.length) return null;

  candidates.sort(function(a, b) {
    if (b.score !== a.score) return b.score - a.score;
    return b.updated.getTime() - a.updated.getTime();
  });

  return candidates[0];
}

/* =========================================================
 * TABLE EXTRACTION
 * ========================================================= */

function extractTablesFromGoogleSheet_(fileId) {
  var ss = SpreadsheetApp.openById(fileId);
  var tables = [];

  ss.getSheets().forEach(function(sh) {
    var values = sh.getDataRange().getDisplayValues();
    if (!values || !values.length) return;

    var normalized = values.map(function(r) {
      return r.map(function(c) {
        return String(c || '').trim();
      });
    });

    var headerInfo = detectHeaderRow_(normalized);
    if (!headerInfo) return;

    tables.push({
      sheetName: sh.getName(),
      headers: headerInfo.headers,
      rows: normalized.slice(headerInfo.rowIndex + 1).filter(function(r) {
        return r.join('').trim() !== '';
      })
    });
  });

  return tables;
}

function extractTablesFromCsv_(file) {
  var text = file.getBlob().getDataAsString();
  var rows = Utilities.parseCsv(text);
  if (!rows || !rows.length) return [];

  var normalized = rows.map(function(r) {
    return r.map(function(c) {
      return String(c || '').trim();
    });
  });

  var headerInfo = detectHeaderRow_(normalized);
  if (!headerInfo) return [];

  return [{
    sheetName: file.getName(),
    headers: headerInfo.headers,
    rows: normalized.slice(headerInfo.rowIndex + 1).filter(function(r) {
      return r.join('').trim() !== '';
    })
  }];
}

function detectHeaderRow_(rows) {
  var candidates = [
    'cut category',
    'cut name',
    'kpi type',
    'question',
    'answer',
    'control',
    'exposed',
    'lift',
    'stat sig 0.8',
    'stat sig 0.9',
    'stat sig 0.95',
    'control total sample',
    'exposed total sample',
    'control size weighted',
    'exposed size weighted',
    'event name',
    'lift estimate',
    'lift conf',
    'incremental',
    'general - campaignid',
    'general - campaignname',
    'general - report_type',
    'dimension - dimension_slug',
    'dimension label - dimension_value',
    'incremental_lift',
    'incremental_visits_projected',
    'lci_confidence_level',
    'incremental sales lift',
    'incremental sales',
    'iroas'
  ];

  var bestRow = -1;
  var bestScore = 0;

  for (var i = 0; i < Math.min(rows.length, 30); i++) {
    var row = rows[i].map(toKey_);
    var score = 0;

    row.forEach(function(cell) {
      candidates.forEach(function(token) {
        if (cell.indexOf(token) >= 0) score++;
      });
    });

    if (score > bestScore) {
      bestScore = score;
      bestRow = i;
    }
  }

  if (bestRow < 0) return null;

  return {
    rowIndex: bestRow,
    headers: rows[bestRow]
  };
}

function tableToObjects_(table) {
  var keys = table.headers.map(toKey_);

  return table.rows.map(function(row) {
    var obj = {};
    keys.forEach(function(key, i) {
      obj[key] = String(row[i] || '').trim();
    });
    return obj;
  });
}

function allTableObjects_(tables) {
  var out = [];
  tables.forEach(function(t) {
    out = out.concat(tableToObjects_(t));
  });
  return out;
}

/* =========================================================
 * ROUTER
 * ========================================================= */

function parseByType_(type, source, rawCellName) {
  if (!source.isStructured) return {};

  if (type === 'brandLift') return parseBrandLiftTable_(source.tables, rawCellName);
  if (type === 'conversionLift') return parseConversionLiftTable_(source.tables, rawCellName);
  if (type === 'salesLift') return parseSalesLiftTable_(source.tables, rawCellName);
  if (type === 'visitationLift') return parseVisitationLiftTable_(source.tables, rawCellName);

  return {};
}

/* =========================================================
 * RAW CELL METADATA PARSER
 * Schema:
 * StudyID_Advertiser_Campaign Details...
 * ========================================================= */

function parseMetadataFromFileName_(rawCellName) {
  var original = String(rawCellName || '').trim();

  var name = original
    .replace(/\.[^.]+$/, '')
    .replace(/\s*\(\d+\)\s*$/, '')
    .trim();

  name = name
    .replace(/_tubitv.*$/i, '')
    .replace(/_tubi.*$/i, '')
    .trim();

  var parts = name.split('_').map(function(p) {
    return String(p || '').trim();
  }).filter(function(p) {
    return p !== '';
  });

  var studyId = parts[0] || '';
  var advertiser = parts[1] || '';
  var campaignDetails = parts.slice(2).join(' ').trim();

  var campaignName = [advertiser, campaignDetails].filter(function(x) {
    return x;
  }).join(' ').trim();

  return {
    studyId: normalizeStudyId_(studyId),
    advertiser: advertiser,
    campaignName: campaignName
  };
}

function applyRawCellMetadata_(result, rawCellName) {
  var meta = parseMetadataFromFileName_(rawCellName);
  result['Study ID'] = meta.studyId || '';
  result['Advertiser'] = meta.advertiser || '';
  result['Campaign Name'] = meta.campaignName || '';
  return meta;
}

function normalizeStudyId_(value) {
  return String(value || '').replace(/\D/g, '').trim();
}

/* =========================================================
 * BRAND LIFT
 * ========================================================= */
function extractBrandLiftCampaignIdFromRows_(rows) {
  if (!rows || !rows.length) return '';

  const explicitFields = [
    'campaign id',
    'campaign_id',
    'campaignid'
  ];

  for (let i = 0; i < rows.length; i++) {
    const direct = firstNonBlankField_(rows[i], explicitFields);
    const normalized = normalizeCampaignId_(String(direct || '').replace(/[^0-9]/g, ''));
    if (normalized) return normalized;
  }

  return '';
}

function normalizeCampaignId_(value) {
  const s = String(value || '').trim();
  if (!/^\d{5,6}$/.test(s)) return '';
  return s;
}
function emptyBrandLiftResult_() {
  return {
    'Study ID': '',
    'Advertiser': '',
    'Campaign Name': '',
    'BLS Msmt Partner': '',
    'Control Response': '',
    'Exposed Response': '',
    'BLS KPI 1': '',
    'KPI 1 Control': '',
    'KPI 1 Treated': '',
    'KPI 1Abs Lift': '',
    'KPI 1 Conf': '',
    'BLS KPI 2': '',
    'KPI 2 Control': '',
    'KPI 2 Treated': '',
    'KPI 2 Abs Lift': '',
    'KPI 2 Conf': '',
    'BLS KPI 3': '',
    'KPI 3 Control': '',
    'KPI 3 Treated': '',
    'KPI 3 Abs Lift': '',
    'KPI 3 Conf': '',
    'BLS KPI 4': '',
    'KPI 4 Control': '',
    'KPI 4 Treated': '',
    'KPI 4 Abs Lift': '',
    'KPI 4 Conf': '',
    'BLS KPI 5': '',
    'KPI 5 Control': '',
    'KPI 5 Treated': '',
    'KPI 5 Abs Lift': '',
    'KPI 5 Conf': ''
  };
}

function parseBrandLiftTable_(tables, rawCellName) {
  var result = emptyBrandLiftResult_();
  applyRawCellMetadata_(result, rawCellName);

  result['BLS Msmt Partner'] =
    inferPartnerFromRawCell_(rawCellName, 'brandLift') ||
    inferPartnerFromTables_(tables, 'brandLift') ||
    '';

  var rows = allTableObjects_(tables);
  if (!rows.length) return result;

  var working = rows.filter(function(r) {
    return matchesOverall_(getField_(r, ['cut category'])) &&
      matchesOverall_(getField_(r, ['cut name']));
  });

  var baseRows = working.length ? working : rows;

  result['Control Response'] = extractBrandLiftControlResponses_(baseRows);
  result['Exposed Response'] = extractBrandLiftExposedResponses_(baseRows);

  var kpiMap = [
    { num: 1, label: 'Awareness', matchers: ['aided awareness', 'awareness'] },
    { num: 2, label: 'Familiarity', matchers: ['familiarity'] },
    { num: 3, label: 'Favorability', matchers: ['favorability'] },
    { num: 4, label: 'Consideration', matchers: ['consideration'] },
    { num: 5, label: 'Intent', matchers: ['purchase intent', 'intent'], fallbackMatchers: ['purchase propensity'] }
  ];

  kpiMap.forEach(function(kpi) {
    var row = findBestBrandLiftRow_(baseRows, kpi.matchers, kpi.fallbackMatchers || []);
    var parsed = row ? parseBrandLiftStructuredRow_(row) : blankBrandMetric_();

    result['BLS KPI ' + kpi.num] = kpi.label;
    result['KPI ' + kpi.num + ' Control'] = parsed.control || '';
    result['KPI ' + kpi.num + ' Treated'] = parsed.exposed || '';

    if (kpi.num === 1) {
      result['KPI 1Abs Lift'] = parsed.lift || '';
    } else {
      result['KPI ' + kpi.num + ' Abs Lift'] = parsed.lift || '';
    }

    result['KPI ' + kpi.num + ' Conf'] = parsed.confidence || '';
  });

  return result;
}


function findBestBrandLiftRow_(rows, primaryMatchers, fallbackMatchers) {
  var primary = rows.filter(function(r) {
    return matchesBrandLiftKpi_(r, primaryMatchers);
  });

  if (primary.length) {
    primary.sort(function(a, b) {
      return scoreBrandLiftRow_(b, primaryMatchers) - scoreBrandLiftRow_(a, primaryMatchers);
    });
    return primary[0];
  }

  var fallback = rows.filter(function(r) {
    return matchesBrandLiftKpi_(r, fallbackMatchers || []);
  });

  if (fallback.length) {
    fallback.sort(function(a, b) {
      return scoreBrandLiftRow_(b, fallbackMatchers) - scoreBrandLiftRow_(a, fallbackMatchers);
    });
    return fallback[0];
  }

  return null;
}

function matchesBrandLiftKpi_(row, matchers) {
  var kpiType = String(getField_(row, ['kpi type']) || '').toLowerCase();
  var question = String(getField_(row, ['question']) || '').toLowerCase();

  for (var i = 0; i < matchers.length; i++) {
    var m = String(matchers[i]).toLowerCase();
    if (kpiType.indexOf(m) >= 0) return true;
    if (question.indexOf(m) >= 0) return true;
  }

  return false;
}

function scoreBrandLiftRow_(row, matchers) {
  var score = 0;

  if (matchesOverall_(getField_(row, ['cut category']))) score += 25;
  if (matchesOverall_(getField_(row, ['cut name']))) score += 25;

  var kpiType = String(getField_(row, ['kpi type']) || '').toLowerCase();
  var question = String(getField_(row, ['question']) || '').toLowerCase();

  for (var i = 0; i < matchers.length; i++) {
    var m = String(matchers[i]).toLowerCase();
    if (kpiType.indexOf(m) >= 0) score += 30;
    if (question.indexOf(m) >= 0) score += 10;
  }

  if (getField_(row, ['control'])) score += 10;
  if (getField_(row, ['exposed'])) score += 10;
  if (getField_(row, ['lift'])) score += 10;

  return score;
}

function parseBrandLiftStructuredRow_(row) {
  var control = normalizePercentDecimalAware_(getField_(row, ['control']));
  var exposed = normalizePercentDecimalAware_(getField_(row, ['exposed']));
  var lift = normalizePercentDecimalAware_(getField_(row, ['lift']));
  var confidence = normalizeBrandLiftConfidenceFromRow_(row);

  return {
    control: control || '',
    exposed: exposed || '',
    lift: lift || '',
    confidence: confidence || ''
  };
}

function normalizeBrandLiftConfidenceFromRow_(row) {
  var sig95 = truthyCell_(getField_(row, ['stat sig 0.95']));
  var sig90 = truthyCell_(getField_(row, ['stat sig 0.9']));
  var sig80 = truthyCell_(getField_(row, ['stat sig 0.8']));

  if (sig95) return '95%';
  if (sig90) return '90%';
  if (sig80) return '80%';
  return 'Not Significant';
}

function truthyCell_(value) {
  var s = String(value || '').trim().toLowerCase();
  return s === 'true' || s === 'yes' || s === '1';
}

function blankBrandMetric_() {
  return { control: '', exposed: '', lift: '', confidence: '' };
}

function extractBrandLiftControlResponses_(rows) {
  for (var i = 0; i < rows.length; i++) {
    var totalSample = firstNonBlankField_(rows[i], ['control total sample']);
    if (totalSample) return totalSample;
  }

  for (var j = 0; j < rows.length; j++) {
    var weighted = firstNonBlankField_(rows[j], ['control size (weighted)']);
    if (weighted) return weighted;
  }

  return '';
}

function extractBrandLiftExposedResponses_(rows) {
  for (var i = 0; i < rows.length; i++) {
    var totalSample = firstNonBlankField_(rows[i], ['exposed total sample']);
    if (totalSample) return totalSample;
  }

  for (var j = 0; j < rows.length; j++) {
    var weighted = firstNonBlankField_(rows[j], ['exposed size (weighted)']);
    if (weighted) return weighted;
  }

  return '';
}

/* =========================================================
 * CONVERSION LIFT
 * ========================================================= */

function emptyConversionResult_() {
  return {
    'Study ID': '',
    'Advertiser': '',
    'Campaign Name': '',
    'CLS Msmt Partner': '',
    'CVR Type': '',
    'CVR Lift': '',
    'CVR Lift Conf': '',
    'Inc Count': '',
    'CPIC': '',
    'CVR Type 2': '',
    'CVR Lift 2': '',
    'CVR Lift Conf 2': '',
    'Inc Count 2': '',
    'CPIC 2': '',
    'CVR Type 3': '',
    'CVR Lift 3': '',
    'CVR Lift Conf 3': '',
    'Inc Count 3': '',
    'CPIC 3': ''
  };
}

function parseConversionLiftTable_(tables, rawCellName) {
  var result = emptyConversionResult_();
  applyRawCellMetadata_(result, rawCellName);

  result['CLS Msmt Partner'] =
    inferPartnerFromRawCell_(rawCellName, 'conversionLift') ||
    inferPartnerFromTables_(tables, 'conversionLift') ||
    '';

  var sourceTable = null;

  for (var i = 0; i < tables.length; i++) {
    var sheetName = String(tables[i].sheetName || '').toLowerCase();
    if (sheetName === 'lift_summary_table' || sheetName.indexOf('lift_summary') >= 0) {
      sourceTable = tables[i];
      break;
    }
  }

  if (!sourceTable) return result;

  var rows = tableToObjects_(sourceTable);
  var events = [];

  for (var r = 0; r < rows.length; r++) {
    var parsed = parseKochavaFandangoRow_(rows[r]);
    if (parsed.name) events.push(parsed);
  }

  var ranked = rankConversionEvents_(events);

  if (ranked[0]) fillConversionSlot_(result, ranked[0], '');
  if (ranked[1]) fillConversionSlot_(result, ranked[1], ' 2');
  if (ranked[2]) fillConversionSlot_(result, ranked[2], ' 3');

  return result;
}

function parseKochavaFandangoRow_(row) {
  var rawName = firstNonBlankField_(row, ['event name', 'event_name', 'conversion', 'conversion event', 'event']);
  var rawLift = firstNonBlankField_(row, ['lift estimate']);
  var rawConfidence = firstNonBlankField_(row, ['lift conf']);
  var rawInc = firstNonBlankField_(row, ['incremental']);

  return {
    name: normalizeKochavaFandangoConversionName_(rawName),
    lift: normalizePercentDecimalAware_(String(rawLift || '').replace('*', '').trim()),
    confidence: normalizeConfidence_(rawConfidence),
    incCount: rawInc || '',
    cpic: ''
  };
}

function normalizeKochavaFandangoConversionName_(value) {
  var s = String(value || '').trim();
  var n = s.toLowerCase();

  if (!n) return '';
  if (n === 'purchase' || /ticket purchase|ticket sale|sale|order/.test(n)) return 'Purchase';
  if (n === 'initiate_checkout' || n === 'initiate checkout' || /begin checkout|checkout/.test(n)) return 'Checkout';
  if (n === 'view' || /page view|landing page view/.test(n)) return 'Page View';
  if (/view content|content view/.test(n)) return 'Content View';
  if (/lead/.test(n)) return 'Lead';
  if (/trial/.test(n)) return 'Trial';
  if (/registration|register/.test(n)) return 'Registration';
  if (/sign-up|signup/.test(n)) return 'Sign-Up';
  if (/install/.test(n)) return 'Install';
  if (/initiate download|download start/.test(n)) return 'Initiate Download';

  return toTitleCase_(s.replace(/_/g, ' '));
}

function fillConversionSlot_(result, event, suffix) {
  result['CVR Type' + suffix] = event.name || '';
  result['CVR Lift' + suffix] = event.lift || '';
  result['CVR Lift Conf' + suffix] = event.confidence || '';
  result['Inc Count' + suffix] = event.incCount || '';
  result['CPIC' + suffix] = event.cpic || '';
}

function rankConversionEvents_(events) {
  return events
    .filter(function(e) {
      return e && e.name;
    })
    .map(function(e) {
      var clone = {};
      for (var k in e) clone[k] = e[k];
      clone.score = conversionPriorityScore_(e.name);
      return clone;
    })
    .sort(function(a, b) {
      return b.score - a.score;
    });
}

function conversionPriorityScore_(name) {
  var n = String(name || '').toLowerCase();

  if (/(purchase|ticket purchase|sale|order|form completion|enrollment|sign-up|signup|install)/.test(n)) return 300;
  if (/(checkout|begin checkout|lead|trial|registration|register)/.test(n)) return 200;
  if (/(page view|landing page view|view content|content view|initiate download|download start)/.test(n)) return 100;

  return 50;
}

/* =========================================================
 * SALES LIFT
 * ========================================================= */

function emptySalesLiftResult_() {
  return {
    'Study ID': '',
    'Advertiser': '',
    'Campaign Name': '',
    'Sales Lift Msmt Partner': '',
    'Sales Type': '',
    'Sales Lift': '',
    'Sales Lift Conf': '',
    'Inc Sales': '',
    'IROAS': '',
    'Sales Type 2': '',
    'Sales Lift 2': '',
    'Inc Sales 2': '',
    'Sales Type 3': '',
    'Sales Lift 3': '',
    'Inc Sales 3': ''
  };
}

function parseSalesLiftTable_(tables, rawCellName) {
  var result = emptySalesLiftResult_();
  applyRawCellMetadata_(result, rawCellName);

  result['Sales Lift Msmt Partner'] =
    inferPartnerFromRawCell_(rawCellName, 'salesLift') ||
    inferPartnerFromTables_(tables, 'salesLift') ||
    '';

  var rows = allTableObjects_(tables);
  if (!rows.length) return result;

  var overallRows = rows.filter(function(r) {
    return matchesOverall_(getField_(r, [
      'general report type',
      'general - report_type',
      'report type'
    ])) &&
    matchesOverall_(getField_(r, [
      'channel',
      'dimension - dimension_slug',
      'dimension label - dimension_value'
    ]));
  });

  var working = overallRows.length ? overallRows : rows;

  var totalRow = findBestSalesRow_(working, 'total');
  var onlineRow = findBestSalesRow_(rows, 'online');
  var storeRow = findBestSalesRow_(rows, 'store');

  if (totalRow) {
    result['Sales Type'] = 'Total Sales';
    result['Sales Lift'] = extractSalesLiftFromRow_(totalRow);
    result['Sales Lift Conf'] = normalizeConfidence_(extractSalesConfidenceFromRow_(totalRow));
    result['Inc Sales'] = extractIncrementalSalesFromRow_(totalRow);
    result['IROAS'] = extractIroasFromRow_(totalRow);
  }

  if (onlineRow) {
    result['Sales Type 2'] = 'Online Sales';
    result['Sales Lift 2'] = extractSalesLiftFromRow_(onlineRow);
    result['Inc Sales 2'] = extractIncrementalSalesFromRow_(onlineRow);
  }

  if (storeRow) {
    result['Sales Type 3'] = 'In-Store Sales';
    result['Sales Lift 3'] = extractSalesLiftFromRow_(storeRow);
    result['Inc Sales 3'] = extractRetailerIncrementalSales_(rows);
  }

  return result;
}


function findBestSalesRow_(rows, bucket) {
  var candidates = rows.filter(function(r) {
    return matchesSalesBucket_(r, bucket);
  });

  if (!candidates.length) return null;

  candidates.sort(function(a, b) {
    return scoreSalesRow_(b, bucket) - scoreSalesRow_(a, bucket);
  });

  return candidates[0];
}

function matchesSalesBucket_(row, bucket) {
  var channel = String(getField_(row, [
    'channel',
    'sales type',
    'dimension label - dimension_value',
    'dimension - dimension_slug',
    'dimension - dimension'
  ]) || '').toLowerCase();

  var reportType = String(getField_(row, [
    'general report type',
    'general - report_type',
    'report type'
  ]) || '').toLowerCase();

  if (bucket === 'total') {
    return matchesOverall_(channel) || matchesOverall_(reportType) || channel === '';
  }

  if (bucket === 'online') {
    return /online|e-?com|ecommerce|digital/.test(channel);
  }

  if (bucket === 'store') {
    return /in-store|instore|store|retail|retailer/.test(channel);
  }

  return false;
}

function scoreSalesRow_(row, bucket) {
  var score = 0;

  if (extractSalesLiftFromRow_(row)) score += 30;
  if (extractIncrementalSalesFromRow_(row)) score += 20;
  if (extractIroasFromRow_(row)) score += 10;

  return score;
}

function extractSalesLiftFromRow_(row) {
  var raw = firstNonBlankField_(row, [
    'incremental sales lift',
    'incremental sales lift %',
    'sales lift',
    'sales lift %'
  ]);

  return normalizePercentDecimalAware_(raw);
}

function extractIncrementalSalesFromRow_(row) {
  return firstNonBlankField_(row, [
    'incremental sales',
    'inc sales'
  ]);
}

function extractSalesConfidenceFromRow_(row) {
  return firstNonBlankField_(row, [
    'confidence',
    'sig',
    'significance',
    'confidence level'
  ]);
}

function extractIroasFromRow_(row) {
  return firstNonBlankField_(row, [
    'iroas'
  ]);
}

function extractRetailerIncrementalSales_(rows) {
  var total = 0;
  var found = false;

  rows.forEach(function(row) {
    var dimension = String(getField_(row, [
      'dimension - dimension',
      'dimension',
      'dimension type'
    ]) || '').toLowerCase().trim();

    if (dimension !== 'retailer') return;

    var raw = firstNonBlankField_(row, [
      'incremental sales',
      'inc sales'
    ]);

    if (!raw || raw === '-') return;

    var num = parseFloat(String(raw).replace(/[^0-9.\-]/g, ''));
    if (isNaN(num)) return;

    total += num;
    found = true;
  });

  if (!found) return '';

  return Math.round(total);
}

/* =========================================================
 * VISITATION LIFT
 * ========================================================= */

function emptyVisitationResult_() {
  return {
    'Study ID': '',
    'Advertiser': '',
    'Campaign Name': '',
    'Visit Msmt Partner': '',
    'Visit Lift %': '',
    'Incremental Visits': '',
    'CPIV': '',
    'Visit Confidence': ''
  };
}

function parseVisitationLiftTable_(tables, rawCellName) {
  var result = emptyVisitationResult_();
  applyRawCellMetadata_(result, rawCellName);

  result['Visit Msmt Partner'] =
    inferPartnerFromRawCell_(rawCellName, 'visitationLift') ||
    inferPartnerFromTables_(tables, 'visitationLift') ||
    '';

  var rows = allTableObjects_(tables);
  if (!rows.length) return result;

  var overallRow = findBestVisitationOverallRow_(rows);
  if (!overallRow) return result;

  result['Visit Lift %'] = extractVisitationLift_(overallRow);
  result['Incremental Visits'] = extractVisitationIncrementalVisits_(overallRow);
  result['CPIV'] = '';
  result['Visit Confidence'] = extractVisitationConfidence_(overallRow);

  return result;
}

function findBestVisitationOverallRow_(rows) {
  var candidates = rows.filter(function(r) {
    return isVisitationOverallRow_(r);
  });

  if (!candidates.length) return null;

  candidates.sort(function(a, b) {
    return scoreVisitationRow_(b) - scoreVisitationRow_(a);
  });

  return candidates[0];
}

function isVisitationOverallRow_(row) {
  var reportType = String(getField_(row, ['general - report_type', 'report_type']) || '').toLowerCase().trim();
  var dimensionSlug = String(getField_(row, ['dimension - dimension_slug', 'dimension_slug']) || '').toLowerCase().trim();
  var dimensionValue = String(getField_(row, ['dimension label - dimension_value', 'dimension_value']) || '').toLowerCase().trim();

  return reportType === 'overall' &&
    dimensionSlug === 'overall' &&
    dimensionValue === 'overall';
}

function scoreVisitationRow_(row) {
  var score = 0;
  if (String(getField_(row, ['foot traffic - incremental lift - incremental_lift'])) !== '') score += 30;
  if (String(getField_(row, ['foot traffic - lci exposed - incremental_visits_projected'])) !== '') score += 30;
  if (String(getField_(row, ['foot traffic - incremental lift - lci_confidence_level'])) !== '') score += 20;
  return score;
}

function extractVisitationLift_(row) {
  var raw = firstNonBlankField_(row, ['foot traffic - incremental lift - incremental_lift']);
  if (raw === '-' || raw === '') return '';
  return normalizePercentDecimalAware_(raw);
}

function extractVisitationConfidence_(row) {
  var raw = firstNonBlankField_(row, ['foot traffic - incremental lift - lci_confidence_level']);
  if (raw === '-' || raw === '') return '';
  return normalizeConfidenceFromDecimal_(raw);
}

function extractVisitationIncrementalVisits_(row) {
  var raw = firstNonBlankField_(row, ['foot traffic - lci exposed - incremental_visits_projected']);
  if (raw === '-' || raw === '') return '';
  return raw;
}

/* =========================================================
 * SHARED HELPERS
 * ========================================================= */

function buildHeaderMap_(headers) {
  var map = {};
  headers.forEach(function(h, i) {
    if (h !== '' && h != null) map[toKey_(h)] = i + 1;
  });
  return map;
}

function toKey_(value) {
  return String(value || '').trim().toLowerCase();
}

function getDataRows_(sheet) {
  var out = [];
  for (var r = CONFIG.HEADER_ROW + 1; r <= sheet.getLastRow(); r++) out.push(r);
  return out;
}

function ensureHeaderExists_(sheet, headerName) {
  var headers = sheet.getRange(CONFIG.HEADER_ROW, 1, 1, sheet.getLastColumn()).getValues()[0];
  var exists = headers.some(function(h) {
    return toKey_(h) === toKey_(headerName);
  });

  if (!exists) {
    sheet.getRange(CONFIG.HEADER_ROW, sheet.getLastColumn() + 1).setValue(headerName);
  }
}

function writeParsedResultsToRow_(sheet, rowNum, headerMap, parsed) {
  Object.keys(parsed).forEach(function(key) {
    var col = headerMap[toKey_(key)];
    if (col) sheet.getRange(rowNum, col).setValue(parsed[key]);
  });
}

function getField_(rowObj, candidates) {
  for (var i = 0; i < candidates.length; i++) {
    var key = toKey_(candidates[i]);
    if (rowObj.hasOwnProperty(key) && rowObj[key] !== '') return rowObj[key];
  }

  var keys = Object.keys(rowObj);
  for (var a = 0; a < candidates.length; a++) {
    var target = toKey_(candidates[a]);
    for (var j = 0; j < keys.length; j++) {
      if (keys[j].indexOf(target) >= 0 && rowObj[keys[j]] !== '') return rowObj[keys[j]];
    }
  }

  return '';
}

function firstNonBlankField_(rowObj, candidates) {
  return getField_(rowObj, candidates);
}

function matchesOverall_(value) {
  var v = String(value || '').toLowerCase().trim();
  return v === 'overall' || v === 'total' || v === 'all' || v === 'overall results';
}

function normalizePercentDecimalAware_(value) {
  if (value === '' || value == null) return '';

  var s = String(value).trim();
  if (!s || s === '-') return '';

  if (s.indexOf('%') >= 0) {
    var pct = parseFloat(s.replace(/[^0-9.\-]/g, ''));
    if (isNaN(pct)) return '';
    return round1_(pct) + '%';
  }

  var num = parseFloat(s.replace(/,/g, ''));
  if (isNaN(num)) return '';

  var out = Math.abs(num) <= 1 ? num * 100 : num;
  return round1_(out) + '%';
}

function normalizeConfidence_(val) {
  var s = String(val || '').toLowerCase().trim();

  if (!s) return '';
  if (s.indexOf('not significant') >= 0 || s.indexOf('not sig') >= 0 || s === 'ns') return 'Not Significant';
  if (s.indexOf('not available') >= 0 || s === 'n/a' || s === 'na') return 'Not Available';
  if (s.indexOf('95') >= 0) return '95%';
  if (s.indexOf('90') >= 0) return '90%';
  if (s.indexOf('80') >= 0) return '80%';

  return '';
}

function normalizeConfidenceFromDecimal_(value) {
  var s = String(value || '').trim();
  if (!s || s === '-') return '';

  var num = parseFloat(s);
  if (isNaN(num)) return normalizeConfidence_(s);

  if (num >= 0.95) return '95%';
  if (num >= 0.90) return '90%';
  if (num >= 0.80) return '80%';
  return 'Not Significant';
}

function round1_(n) {
  return Math.round(n * 10) / 10;
}

function toTitleCase_(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/\b\w/g, function(c) {
      return c.toUpperCase();
    });
}

/* =========================================================
 * MEASUREMENT PARTNER EXTRACTION
 * ========================================================= */

function extractMeasurementPartner_(rows, parserType, fileName, tables) {
  const direct = extractMeasurementPartnerFromFields_(rows, parserType);
  if (direct) return direct;

  const fromFile = normalizeMeasurementPartner_(fileName, parserType);
  if (fromFile) return fromFile;

  const fromTabs = extractMeasurementPartnerFromTabNames_(tables, parserType);
  if (fromTabs) return fromTabs;

  const fromRows = extractMeasurementPartnerFromRowsText_(rows, parserType);
  if (fromRows) return fromRows;

  return '';
}

function extractMeasurementPartnerFromFields_(rows, parserType) {
  if (!rows || !rows.length) return '';

  const fieldCandidates = [
    'measurement partner',
    'msmt partner',
    'partner',
    'provider',
    'vendor',
    'study provider',
    'research partner',
    'data provider'
  ];

  for (let i = 0; i < rows.length; i++) {
    const direct = firstNonBlankField_(rows[i], fieldCandidates);
    const normalized = normalizeMeasurementPartner_(direct, parserType);
    if (normalized) return normalized;
  }

  return '';
}

function extractMeasurementPartnerFromRowsText_(rows, parserType) {
  if (!rows || !rows.length) return '';

  for (let i = 0; i < rows.length; i++) {
    const normalized = normalizeMeasurementPartner_(JSON.stringify(rows[i]), parserType);
    if (normalized) return normalized;
  }

  return '';
}

function extractMeasurementPartnerFromTabNames_(tables, parserType) {
  if (!tables || !tables.length) return '';

  for (let i = 0; i < tables.length; i++) {
    const normalized = normalizeMeasurementPartner_(tables[i].sheetName, parserType);
    if (normalized) return normalized;
  }

  return '';
}

function extractMeasurementPartnerFromRows_(rows, parserType) {
  return extractMeasurementPartnerFromFields_(rows, parserType) || extractMeasurementPartnerFromRowsText_(rows, parserType);
}

function extractMeasurementPartnerFromText_(text, parserType) {
  return normalizeMeasurementPartner_(text, parserType);
}

function extractMeasurementPartnerFromSourceName_(fileName, parserType) {
  return normalizeMeasurementPartner_(fileName, parserType);
}

function normalizeMeasurementPartner_(value, parserType) {
  const text = String(value || '').toLowerCase();
  if (!text) return '';

  const allowed = allowedPartnersByParser_(parserType);

  const checks = [
    { patterns: ['upwave'], output: 'Upwave' },
    { patterns: ['kantar'], output: 'Kantar' },
    { patterns: ['disqo'], output: 'DISQO' },
    { patterns: ['lucid'], output: 'Lucid' },
    { patterns: ['dynata'], output: 'Dynata' },
    { patterns: ['nielsen'], output: 'Nielsen' },
    { patterns: ['inmarket', 'in market'], output: 'InMarket' },
    { patterns: ['foursquare'], output: 'Foursquare' },
    { patterns: ['circana'], output: 'Circana' },
    { patterns: ['ncsolutions', 'ncs'], output: 'NCS' },
    { patterns: ['kochava-fandango', 'kochava fandango', 'kochava + fandango', 'fandango'], output: 'Kochava-Fandango' },
    { patterns: ['kochava-shopify', 'kochava shopify', 'kochava - shopify'], output: 'Kochava-Shopify' },
    { patterns: ['kochava-fetch', 'kochava fetch', 'kochava - fetch'], output: 'Kochava-Fetch' },
    { patterns: ['appsflyer', 'apps flyer'], output: 'AppsFlyer' },
    { patterns: ['attain'], output: 'Attain' },
    { patterns: ['abcs'], output: 'ABCS' },
    { patterns: ['kochava'], output: 'Kochava' }
  ];

  for (let i = 0; i < checks.length; i++) {
    const c = checks[i];
    if (allowed.length && allowed.indexOf(c.output) === -1) continue;

    for (let j = 0; j < c.patterns.length; j++) {
      if (text.indexOf(c.patterns[j]) >= 0) return c.output;
    }
  }

  return '';
}

function allowedPartnersByParser_(parserType) {
  if (parserType === 'brandLift') {
    return ['Upwave', 'Kantar', 'DISQO', 'Lucid', 'Dynata', 'Nielsen'];
  }

  if (parserType === 'conversionLift') {
    return ['Kochava', 'Kochava-Fandango', 'Kochava-Shopify', 'Kochava-Fetch', 'AppsFlyer'];
  }

  if (parserType === 'salesLift') {
    return ['InMarket', 'Circana', 'NCS', 'Kochava-Shopify', 'Kochava-Fetch', 'Attain', 'ABCS', 'Kochava'];
  }

  if (parserType === 'visitationLift') {
    return ['InMarket', 'Foursquare'];
  }

  return [];
}

/* =========================================================
 * PARTNER NORMALIZATION
 * ========================================================= */

function inferPartnerFromRawCell_(rawCellName, parserType) {
  return normalizeMeasurementPartner_(rawCellName, parserType);
}

function inferPartnerFromTables_(tables, parserType) {
  for (var i = 0; i < tables.length; i++) {
    var fromTab = normalizeMeasurementPartner_(tables[i].sheetName, parserType);
    if (fromTab) return fromTab;

    var rows = tableToObjects_(tables[i]);
    for (var r = 0; r < Math.min(rows.length, 5); r++) {
      var fromRow = normalizeMeasurementPartner_(JSON.stringify(rows[r]), parserType);
      if (fromRow) return fromRow;
    }
  }

  return '';
}

function normalizeMeasurementPartner_(value, parserType) {
  var text = String(value || '').toLowerCase().trim();
  if (!text) return '';

  var allowed = allowedPartnersByParser_(parserType);

  var checks = [
    { patterns: ['upwave'], output: 'Upwave' },
    { patterns: ['kantar'], output: 'Kantar' },
    { patterns: ['disqo'], output: 'DISQO' },
    { patterns: ['lucid'], output: 'Lucid' },
    { patterns: ['dynata'], output: 'Dynata' },
    { patterns: ['nielsen'], output: 'Nielsen' },
    { patterns: ['inmarket', 'in market'], output: 'InMarket' },
    { patterns: ['foursquare'], output: 'Foursquare' },
    { patterns: ['circana'], output: 'Circana' },
    { patterns: ['ncsolutions', 'ncs'], output: 'NCS' },
    { patterns: ['kochava-fandango', 'kochava fandango', 'kochava + fandango', 'fandango'], output: 'Kochava-Fandango' },
    { patterns: ['kochava-shopify', 'kochava shopify', 'kochava - shopify'], output: 'Kochava-Shopify' },
    { patterns: ['kochava-fetch', 'kochava fetch', 'kochava - fetch'], output: 'Kochava-Fetch' },
    { patterns: ['appsflyer', 'apps flyer'], output: 'AppsFlyer' },
    { patterns: ['attain'], output: 'Attain' },
    { patterns: ['abcs'], output: 'ABCS' },
    { patterns: ['kochava'], output: 'Kochava' }
  ];

  for (var i = 0; i < checks.length; i++) {
    var c = checks[i];
    if (allowed.length && allowed.indexOf(c.output) === -1) continue;

    for (var j = 0; j < c.patterns.length; j++) {
      if (text.indexOf(c.patterns[j]) >= 0) return c.output;
    }
  }

  return '';
}

function allowedPartnersByParser_(parserType) {
  if (parserType === 'brandLift') {
    return ['Upwave', 'Kantar', 'DISQO', 'Lucid', 'Dynata', 'Nielsen'];
  }

  if (parserType === 'conversionLift') {
    return ['Kochava', 'Kochava-Fandango', 'Kochava-Shopify', 'Kochava-Fetch', 'AppsFlyer'];
  }

  if (parserType === 'salesLift') {
    return ['InMarket', 'Circana', 'NCS', 'Kochava-Shopify', 'Kochava-Fetch', 'Attain', 'ABCS', 'Kochava'];
  }

  if (parserType === 'visitationLift') {
    return ['InMarket', 'Foursquare'];
  }

  return [];
}

/* =========================================================
 * DEBUG
 * ========================================================= */

function testFileNameMetadata_() {
  var examples = [
    '33706_Burger King_National - Q2 2024 - $5YWM - Digital - Mapped_tubitv_10_20_24 (1).csv',
    '12345_McDonalds_National - Q1 2026 - Digital.csv',
    '45678_Mars_Temptations - Q2 2026 - CTV - Mapped_tubi.csv'
  ];

  examples.forEach(function(name) {
    Logger.log(name + ' => ' + JSON.stringify(parseMetadataFromFileName_(name)));
  });
}
