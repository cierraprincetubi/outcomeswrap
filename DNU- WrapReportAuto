function createWrapReportsForAllRows() {
  const SPREADSHEET_ID = "17WN0e84Q6dansBrMu_PE1YhF1wmWobN0oIzb22RSR8s";
  const TEMPLATE_ID = "1lmWSQJbZtMHf4M_m0S0GmJik1ba4ovZJRXwuixO6ktk";
  const OUTPUT_FOLDER_ID = "1cleKvIbzlBwJDqoJI1lCkrN7hOl00kuD";
  const BLS_PLACEHOLDER = "{{BLS_CHART}}";
  const SALES_LIFT_PLACEHOLDER = "{{SALES_LIFT_CHART}}";

  const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
  const sheet = spreadsheet.getSheets()[0];
  const rootFolder = DriveApp.getFolderById(OUTPUT_FOLDER_ID);

  ensureLeadingColumns(sheet, ["Quarter", "Season", "Year"]);

  let data = sheet.getDataRange().getDisplayValues();
  let headers = data[0];

  getOrCreateColumn(sheet, headers, "Deck URL");
  getOrCreateColumn(sheet, headers, "Generated At");

  data = sheet.getDataRange().getDisplayValues();
  headers = data[0];

  const quarterCol = headers.indexOf("Quarter") + 1;
  const seasonCol = headers.indexOf("Season") + 1;
  const yearCol = headers.indexOf("Year") + 1;
  const deckUrlColUpdated = headers.indexOf("Deck URL") + 1;
  const generatedAtColUpdated = headers.indexOf("Generated At") + 1;

  if (data.length < 2) {
    Logger.log("No campaign rows found.");
    return;
  }

  for (let r = 1; r < data.length; r++) {
    const row = data[r];
    if (row.join("").trim() === "") continue;

    const rowData = {};
    headers.forEach(function(header, i) {
      rowData[String(header || "").trim()] = row[i];
    });

    const campaignName = String(rowData["Campaign Name"] || "").trim();
    const existingDeckUrl = String(rowData["Deck URL"] || "").trim();

    if (campaignName === "") {
      Logger.log("Skipped row " + (r + 1) + ": Campaign Name is blank.");
      continue;
    }

    if (existingDeckUrl !== "") {
      Logger.log("Skipped existing report for row " + (r + 1) + ": " + (rowData["Report Name"] || campaignName));
      continue;
    }

    try {
      const generatedAt = new Date();
      sheet.getRange(r + 1, generatedAtColUpdated).setValue(generatedAt);

      const campaignStartDate = parseSheetDate(rowData["Campaign Start Date"]);
      if (!campaignStartDate) {
        throw new Error('Invalid or blank "Campaign Start Date" for row ' + (r + 1));
      }

      const fiscal = getFiscalAttributes(campaignStartDate);
      sheet.getRange(r + 1, quarterCol).setValue(fiscal.quarter);
      sheet.getRange(r + 1, seasonCol).setValue(fiscal.season);
      sheet.getRange(r + 1, yearCol).setValue(fiscal.year);

      SpreadsheetApp.flush();

      const refreshedHeaders = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];
      const refreshedRow = sheet.getRange(r + 1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];

      const refreshedRowData = {};
      refreshedHeaders.forEach(function(header, i) {
        refreshedRowData[String(header || "").trim()] = refreshedRow[i];
      });

      const reportLabel = firstNonEmpty([
        refreshedRowData["Report Name"],
        "Wrap Report"
      ]);

      const yearFolder = getOrCreateSubfolder(rootFolder, String(fiscal.year));
      const deckName = buildDeckName(fiscal.quarter, fiscal.year, reportLabel);

      const copy = DriveApp.getFileById(TEMPLATE_ID).makeCopy(deckName, yearFolder);
      const presentation = SlidesApp.openById(copy.getId());

      const deckUrl = presentation.getUrl();
      sheet.getRange(r + 1, deckUrlColUpdated).setValue(deckUrl);

      refreshedHeaders.forEach(function(header) {
        const cleanHeader = String(header || "").trim();
        presentation.replaceAllText("{{" + cleanHeader + "}}", refreshedRowData[cleanHeader] || "");
      });

      const blsChartValue = String(refreshedRowData["BLS Chart URL"] || "").trim();
      if (blsChartValue !== "") {
        try {
          const fileId = extractDriveFileId(blsChartValue);
          replacePlaceholderWithDriveImage(presentation, BLS_PLACEHOLDER, fileId);
          Logger.log("Inserted BLS chart for row " + (r + 1) + ": " + deckName);
        } catch (imageError) {
          Logger.log("Failed to insert BLS chart for row " + (r + 1) + " (" + deckName + "): " + imageError.message);
        }
      } else {
        Logger.log("No BLS Chart URL value for row " + (r + 1) + ": " + deckName);
      }

      const salesChartValue = String(refreshedRowData["Sales Chart URL"] || "").trim();
      if (salesChartValue !== "") {
        try {
          const fileId = extractDriveFileId(salesChartValue);
          replacePlaceholderWithDriveImage(presentation, SALES_LIFT_PLACEHOLDER, fileId);
          Logger.log("Inserted Sales chart for row " + (r + 1) + ": " + deckName);
        } catch (imageError) {
          Logger.log("Failed to insert Sales chart for row " + (r + 1) + " (" + deckName + "): " + imageError.message);
        }
      } else {
        Logger.log("No Sales Chart URL value for row " + (r + 1) + ": " + deckName);
      }

      removeIrrelevantSlidesByMarker(presentation, refreshedRowData);

      presentation.saveAndClose();
      Logger.log("Created: " + deckName);
    } catch (e) {
      Logger.log("ERROR on row " + (r + 1) + " (" + (rowData["Report Name"] || campaignName) + "): " + e.message);
    }
  }
}

function buildDeckName(quarter, year, reportName) {
  return String(quarter || "").trim() + " " + String(year || "").trim() + " " + String(reportName || "").trim() + " Wrap";
}

function getOrCreateSubfolder(parentFolder, folderName) {
  const folders = parentFolder.getFoldersByName(folderName);
  if (folders.hasNext()) {
    return folders.next();
  }
  return parentFolder.createFolder(folderName);
}

function replacePlaceholderWithDriveImage(presentation, placeholderText, fileId) {
  const file = DriveApp.getFileById(fileId);
  const mimeType = file.getMimeType();

  if (!mimeType.startsWith("image/")) {
    throw new Error("Chart file is not an image. Mime type: " + mimeType);
  }

  const imageBlob = file.getBlob();
  const slides = presentation.getSlides();
  let found = false;

  for (let i = 0; i < slides.length; i++) {
    const slide = slides[i];
    const result = findPlaceholderElement(slide.getPageElements(), placeholderText);

    if (result) {
      const element = result.element;
      slide.insertImage(imageBlob, element.getLeft(), element.getTop(), element.getWidth(), element.getHeight());
      element.remove();
      Logger.log("Inserted image into slide " + (i + 1));
      found = true;
      break;
    }
  }

  if (!found) {
    throw new Error(
      'Placeholder ' + placeholderText + ' not found. Put a normal text box on the slide itself containing exactly ' + placeholderText
    );
  }
}

function findPlaceholderElement(pageElements, placeholderText) {
  for (let i = 0; i < pageElements.length; i++) {
    const element = pageElements[i];
    const type = element.getPageElementType();

    if (type === SlidesApp.PageElementType.SHAPE) {
      try {
        const text = element.asShape().getText().asString().trim();
        if (normalizePlaceholder(text) === normalizePlaceholder(placeholderText)) {
          return { element: element };
        }
      } catch (e) {}
    }

    if (type === SlidesApp.PageElementType.GROUP) {
      try {
        const children = element.asGroup().getChildren();
        const result = findPlaceholderElement(children, placeholderText);
        if (result) return result;
      } catch (e) {}
    }
  }

  return null;
}

function normalizePlaceholder(text) {
  return String(text || "").replace(/\s+/g, "").trim();
}

function extractDriveFileId(value) {
  value = String(value || "").trim();

  if (!value.includes("http")) {
    return value;
  }

  let match = value.match(/\/file\/d\/([-\w]{25,})/);
  if (match) return match[1];

  match = value.match(/[?&]id=([-\w]{25,})/);
  if (match) return match[1];

  match = value.match(/[-\w]{25,}/);
  if (match) return match[0];

  throw new Error("Could not extract Drive file ID from: " + value);
}

function getOrCreateColumn(sheet, headers, columnName) {
  const existingIndex = headers.indexOf(columnName);
  if (existingIndex !== -1) {
    return existingIndex + 1;
  }

  const newCol = headers.length + 1;
  sheet.getRange(1, newCol).setValue(columnName);
  return newCol;
}

function ensureLeadingColumns(sheet, desiredHeaders) {
  const currentHeaders = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0];

  for (let i = desiredHeaders.length - 1; i >= 0; i--) {
    if (currentHeaders[i] !== desiredHeaders[i]) {
      sheet.insertColumnBefore(1);
    }
  }

  for (let i = 0; i < desiredHeaders.length; i++) {
    sheet.getRange(1, i + 1).setValue(desiredHeaders[i]);
  }
}

function parseSheetDate(value) {
  if (!value) return null;

  if (Object.prototype.toString.call(value) === "[object Date]" && !isNaN(value.getTime())) {
    return value;
  }

  const parsed = new Date(value);
  if (!isNaN(parsed.getTime())) {
    return parsed;
  }

  return null;
}

function getFiscalAttributes(date) {
  const month = date.getMonth() + 1;
  const year = date.getFullYear();

  let quarter = "";
  let season = "";

  if (month >= 1 && month <= 3) {
    quarter = "Q1";
  } else if (month >= 4 && month <= 6) {
    quarter = "Q2";
  } else if (month >= 7 && month <= 9) {
    quarter = "Q3";
  } else {
    quarter = "Q4";
  }

  if (month === 12 || month === 1 || month === 2) {
    season = "Winter";
  } else if (month >= 3 && month <= 5) {
    season = "Spring";
  } else if (month >= 6 && month <= 8) {
    season = "Summer";
  } else {
    season = "Fall";
  }

  return {
    quarter: quarter,
    season: season,
    year: year
  };
}

function removeIrrelevantSlidesByMarker(presentation, rowData) {
  const slides = presentation.getSlides();

  for (let i = slides.length - 1; i >= 0; i--) {
    const slide = slides[i];
    const slideText = getAllSlideText(slide);

    if (shouldRemoveSlideByMarker(slideText, rowData)) {
      slide.remove();
      Logger.log("Removed slide " + (i + 1) + " based on marker.");
    } else {
      removeSlideMarkers(slide);
    }
  }
}

function shouldRemoveSlideByMarker(slideText, rowData) {
  const text = String(slideText || "");

  if (text.indexOf("[[REMOVE_IF_NO_BLS]]") !== -1) {
    const hasBlsData =
      String(rowData["BLS KPI 1"] || "").trim() !== "" ||
      String(rowData["BLS KPI 2"] || "").trim() !== "" ||
      String(rowData["BLS KPI 3"] || "").trim() !== "" ||
      String(rowData["BLS KPI 4"] || "").trim() !== "" ||
      String(rowData["BLS KPI 5"] || "").trim() !== "";
    return !hasBlsData;
  }

  if (text.indexOf("[[REMOVE_IF_NO_BLS_CHART]]") !== -1) {
    return String(rowData["BLS Chart URL"] || "").trim() === "";
  }

  if (text.indexOf("[[REMOVE_IF_NO_SALES]]") !== -1) {
    const hasSalesData =
      String(rowData["Sales Lift"] || "").trim() !== "" ||
      String(rowData["Sales Lift 2"] || "").trim() !== "" ||
      String(rowData["Sales Lift 3"] || "").trim() !== "" ||
      String(rowData["Inc Sales"] || "").trim() !== "" ||
      String(rowData["IROAS"] || "").trim() !== "";
    return !hasSalesData;
  }

  if (text.indexOf("[[REMOVE_IF_NO_SALES_CHART]]") !== -1) {
    return String(rowData["Sales Chart URL"] || "").trim() === "";
  }

  if (text.indexOf("[[REMOVE_IF_NO_DELIVERY]]") !== -1) {
    const hasDeliveryData =
      String(rowData["Spend"] || "").trim() !== "" ||
      String(rowData["Imps"] || "").trim() !== "" ||
      String(rowData["Reach"] || "").trim() !== "" ||
      String(rowData["Video View Completions"] || "").trim() !== "" ||
      String(rowData["Frequency"] || "").trim() !== "" ||
      String(rowData["Weekly Frequency"] || "").trim() !== "" ||
      String(rowData["VVCR"] || "").trim() !== "";
    return !hasDeliveryData;
  }

  if (text.indexOf("[[REMOVE_IF_NO_VISITS]]") !== -1) {
    const hasVisitData =
      String(rowData["Incremental Visit Lift %"] || "").trim() !== "" ||
      String(rowData["Incremental Visits"] || "").trim() !== "" ||
      String(rowData["Total Incremental Visits"] || "").trim() !== "" ||
      String(rowData["CPIV"] || "").trim() !== "";
    return !hasVisitData;
  }

  if (text.indexOf("[[REMOVE_IF_NO_CONVERSION]]") !== -1) {
    const hasConversionData =
      String(rowData["CVR Lift"] || "").trim() !== "" ||
      String(rowData["CVR Lift 2"] || "").trim() !== "" ||
      String(rowData["CVR Lift 3"] || "").trim() !== "" ||
      String(rowData["Inc Count"] || "").trim() !== "" ||
      String(rowData["Inc Count 2"] || "").trim() !== "" ||
      String(rowData["Inc Count 3"] || "").trim() !== "" ||
      String(rowData["CPIC"] || "").trim() !== "" ||
      String(rowData["CPIC 2"] || "").trim() !== "" ||
      String(rowData["CPIC 3"] || "").trim() !== "";
    return !hasConversionData;
  }

  if (text.indexOf("[[REMOVE_IF_NO_RECOMMENDATIONS]]") !== -1) {
    return String(rowData["Recommendations"] || "").trim() === "";
  }

  return false;
}

function getAllSlideText(slide) {
  const pageElements = slide.getPageElements();
  let text = "";

  for (let i = 0; i < pageElements.length; i++) {
    text += extractTextFromElement(pageElements[i]) + "\n";
  }

  return text;
}

function extractTextFromElement(element) {
  const type = element.getPageElementType();

  if (type === SlidesApp.PageElementType.SHAPE) {
    try {
      return element.asShape().getText().asString();
    } catch (e) {
      return "";
    }
  }

  if (type === SlidesApp.PageElementType.GROUP) {
    try {
      const children = element.asGroup().getChildren();
      let text = "";
      for (let i = 0; i < children.length; i++) {
        text += extractTextFromElement(children[i]) + "\n";
      }
      return text;
    } catch (e) {
      return "";
    }
  }

  return "";
}

function removeSlideMarkers(slide) {
  const markers = [
    "[[REMOVE_IF_NO_BLS]]",
    "[[REMOVE_IF_NO_BLS_CHART]]",
    "[[REMOVE_IF_NO_SALES]]",
    "[[REMOVE_IF_NO_SALES_CHART]]",
    "[[REMOVE_IF_NO_DELIVERY]]",
    "[[REMOVE_IF_NO_VISITS]]",
    "[[REMOVE_IF_NO_CONVERSION]]",
    "[[REMOVE_IF_NO_RECOMMENDATIONS]]"
  ];

  for (let i = 0; i < markers.length; i++) {
    slide.replaceAllText(markers[i], "");
  }
}

function firstNonEmpty(values) {
  for (let i = 0; i < values.length; i++) {
    const v = String(values[i] || "").trim();
    if (v !== "") return v;
  }
  return "";
}
