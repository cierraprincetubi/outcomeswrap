function maybeBuildSalesChartBlob_(rowData, campaignName) {
  const totalLift = parsePercentNumber_(getFirstValue_(rowData, [
    "Sales Lift",
    "Sales Lift %",
    "Total Sales Lift",
    "Total Sales Lift %"
  ]));

  const totalConfRaw = String(getFirstValue_(rowData, [
    "Sales Lift Conf",
    "Sales Lift Confidence",
    "Confidence",
    "Sig"
  ]) || "").trim();

  if (totalLift === null) {
    return null;
  }

  const labels = ["Total Sales Lift"];
  const values = [totalLift];

  const bubbleLabel = formatLiftBubbleLabel_(round1_(totalLift));
  const bubbleColor = getLiftBubbleColor_(round1_(totalLift), totalConfRaw);

  const chartConfig = {
    type: "bar",
    data: {
      labels: labels,
      datasets: [{
        data: values,
        backgroundColor: ["#FFDE21"],
        borderRadius: 8,
        borderSkipped: false,
        barThickness: 120,
        categoryPercentage: 0.5,
        barPercentage: 0.8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      layout: {
        padding: { top: 70, right: 40, bottom: 20, left: 40 }
      },
      plugins: {
        legend: { display: false },
        title: {
          display: true,
          text: campaignName + " Sales Lift",
          color: "#FFFFFF",
          font: { size: 28, weight: "bold" },
          padding: { bottom: 20 }
        },
        annotation: {
          annotations: {
            salesBubble: makeBubble_(
              labels[0],
              values[0],
              bubbleLabel,
              bubbleColor,
              "#FFFFFF"
            )
          }
        }
      },
      scales: {
        x: {
          ticks: {
            color: "#FFFFFF",
            font: { size: 22 },
            maxRotation: 0,
            minRotation: 0
          },
          grid: { display: false },
          border: { display: false }
        },
        y: {
          beginAtZero: true,
          ticks: {
            color: "#FFFFFF",
            font: { size: 18 },
            callback: function(value) {
              return value + "%";
            }
          },
          grid: {
            color: "rgba(255,255,255,0.12)",
            drawBorder: false
          },
          border: { display: false }
        }
      }
    }
  };

  return fetchQuickChartPng_(
    chartConfig,
    safeFileName_(campaignName) + "_sales_chart.png",
    1000,
    650
  );
}
